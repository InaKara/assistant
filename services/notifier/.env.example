# ntfy notifier configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Required: outbound topic — agent sends notifications to your phone
NTFY_TOPIC=your-secret-outbound-topic-here

# Required: inbox topic — you send messages from your phone to the agent
NTFY_INBOX_TOPIC=your-secret-inbox-topic-here

# Optional: override if self-hosting ntfy (default: https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh
